# ---------------------------------------------------------------------------
# docker compose (docker-compose.yml) reads these
# ---------------------------------------------------------------------------
# Required: shared by web (NextAuth) and server (socket auth). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
# Required: password for the compose Postgres (web and server get it as PGPASSWORD).
# Generate one the same way; it is set when the postgres volume is first created.
POSTGRES_PASSWORD=
# Public URLs as browsers see them (put both behind HTTPS in production)
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_SOCKET_URL=http://localhost:4000
WEB_PORT=3000

# Code execution: docker (sandbox containers, default in compose) | judge0 | local (dev only, NOT sandboxed)
CODE_RUNNER=docker
JUDGE0_URL=
JUDGE0_API_KEY=
# parallel judging jobs per server
JUDGE_CONCURRENCY=4

# Optional OAuth sign-in
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Running the apps directly (npm run dev) instead of through compose
# ---------------------------------------------------------------------------
# Not needed for the no-Docker flow (npm run *:local): scripts/with-local-env.mjs
# generates its own credentials in .local-db/credentials.json.
# Otherwise set it to your Postgres connection string (user, URL-encoded password,
# host, port, database). To build one from PGHOST / PGPORT / PGUSER / PGPASSWORD /
# PGDATABASE instead:  DATABASE_URL="$(node scripts/database-url.mjs)"
DATABASE_URL=
# REDIS_URL=memory swaps Redis + Bull for an in-process mock and queue
REDIS_URL=redis://localhost:6379
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# comma-separated origins the battle server accepts in production
WEB_ORIGIN=http://localhost:3000
# password-less "pick a username" login, ignored when NODE_ENV=production
DEV_LOGIN=

# ---------------------------------------------------------------------------
# Tuning (all optional)
# ---------------------------------------------------------------------------
# MATCH_DURATION_SECONDS=        # override per-difficulty battle length (15/25/40 min)
# SUDDEN_DEATH_SECONDS=300       # time the opponent keeps after a full solve
# READY_TIMEOUT_SECONDS=60       # both players must open the battle within this
# QUEUE_TIMEOUT_SECONDS=90
# RUNS_PER_MINUTE=20             # example runs + practice judging per player
# Battle socket event limits (token bucket per socket; per user = x SOCKET_USER_LIMIT_FACTOR)
# SOCKET_RATE_LIMIT=on           # "off" disables socket event limits
# SOCKET_TELEMETRY_BURST=20  SOCKET_TELEMETRY_PER_SEC=5   # battle:typing, battle:snapshot
# SOCKET_ACTION_BURST=5      SOCKET_ACTION_PER_SEC=0.5    # battle:run, battle:submit
# SOCKET_CONTROL_BURST=10    SOCKET_CONTROL_PER_SEC=1     # battle:ready, battle:forfeit
# SOCKET_USER_LIMIT_FACTOR=2     # per-user buckets (all tabs) are this many times the socket limits
# SOCKET_MAX_VIOLATIONS=20       # rejected events within the window before the socket is disconnected
# SOCKET_VIOLATION_WINDOW_MS=60000
# DOCKER_RUNTIME=runsc           # e.g. gVisor for stronger sandboxing
# DOCKER_IMAGE_PYTHON=python:3.12-slim
# DOCKER_IMAGE_NODE=node:20-slim
# DOCKER_IMAGE_JAVA=eclipse-temurin:21-jdk
# JUDGE0_PYTHON_ID=71  JUDGE0_JAVASCRIPT_ID=63  JUDGE0_JAVA_ID=62
# CPP_STACK_LIMIT_KB=262144       # C++ stack (default 256 MB) so deep recursion doesn't segfault
# JUDGE0_MAX_STACK_LIMIT_KB=128000 # Judge0's MAX_STACK_LIMIT; stack_limit sent to Judge0 is capped at this (docker-compose defaults it to 262144 and sets the bundled Judge0's MAX_STACK_LIMIT to match)
# ALLOW_UNSAFE_LOCAL_RUNNER=1    # permit CODE_RUNNER=local in production (don't)

# ---------------------------------------------------------------------------
# Demo data (npm run db:local:demo): refuses NODE_ENV=production unless this is set. Don't set it.
# ALLOW_DEMO_SEED=
